# Application
APP_NAME="AI Mockup Platform"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Supabase)
DATABASE_URL="postgresql://username:password@db.supabase.co:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Redis (optional - not needed for basic operation)
# REDIS_URL="redis://localhost:6379/0"

# AWS S3 Storage (optional - using local storage by default)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="ai-mockup-platform"

# Payment Processing
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AI/GPU Processing
HUGGINGFACE_TOKEN="your-hf-token"
RUNPOD_API_KEY="your-runpod-api-key"
AWS_EC2_INSTANCE_ID="i-1234567890abcdef0"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="noreply@aimockup.com"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_MOCKUP_GENERATION_PER_HOUR=50
RATE_LIMIT_PAYMENTS_PER_HOUR=10
RATE_LIMIT_GENERAL_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=".jpg,.jpeg,.png,.webp"

# Credit System
FREE_CREDITS_ON_SIGNUP=3

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Email TLS Configuration
SMTP_USE_TLS=true

# Background Tasks Configuration (optional - Celery not used)
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"
# WORKER_CONCURRENCY=4
# TASK_TIMEOUT=300

# AI Processing Configuration
USE_GPU=false
MODEL_CACHE_DIR="./models"
MOCKUP_OUTPUT_DIR="./uploads/mockups"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

# Security Configuration
TRUSTED_HOSTS="localhost,127.0.0.1"
ENABLE_HTTPS=false

# Monitoring Configuration (optional)
SENTRY_DSN=""
PROMETHEUS_ENABLED=false

# Testing Configuration
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/fastleopard_test"